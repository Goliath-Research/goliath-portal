# Connection order matches GoliathOmics (platform_env.py + deploy/env/README.md):
#   1. GOLIATH_DATABASE_URL
#   2. WF_DATABASE_URL
#   3. METHYLPIPELINE_DB          (one-release alias)
#   4. POSTGRES_HOST / PORT / DB / USER / PASSWORD / SSLMODE / CHANNEL_BINDING
#   5. deploy/targets/goliath-test.json next to this repo (portal role)
#
# goliath-test Neon, from GoliathOmics/deploy/targets/goliath-test.json.
# The password is not in git. Export secret:GOLIATH_PORTAL_DB_PASSWORD.
POSTGRES_HOST=ep-wandering-pine-a5l8s690-pooler.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=GoliathOmics
POSTGRES_USER=goliath_portal
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
POSTGRES_CHANNEL_BINDING=require

# Direct host for schema apply (not the pooler):
# ep-wandering-pine-a5l8s690.us-east-2.aws.neon.tech

AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_DEV_LOGIN=1
AUTH_DEV_PASSWORD=portal
GOLIATH_PORTAL_OPERATORS=operator@goliath.dev
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0
